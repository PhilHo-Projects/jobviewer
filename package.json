{
  "name": "job-viewer",
  "version": "1.0.0",
  "type": "module",
  "description": "LinkedIn job posts viewer for n8n workflow",
  "main": "dist-server/server.js",
  "scripts": {
    "start": "node dist-server/server.js",
    "dev:ui": "vite",
    "dev:server": "nodemon --exec tsx server.ts",
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:server\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "node --import tsx --test \"server/**/*.test.ts\" \"src/**/*.test.ts\""
  },
  "dependencies": {
    "better-auth": "1.7.1",
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^25.3.2",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.4",
    "nodemon": "^3.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  }
}
